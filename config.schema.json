{
  "pluginAlias": "smartgaragedoor",
  "pluginType": "accessory",
  "singular": false,
  "schema": {
    "definitions": {
      "ValidPin": {
        "type": "integer",
        "enum": [5, 6, 12, 13, 16, 17, 22, 23, 24, 25, 26, 27]
      },
      "SensorSignal": {
        "type": "string",
        "oneOf": [
          { "title": "Normally Open", "const": ["NO"] },
          { "title": "Normally Closed", "const": ["NC"] }
        ]
      }
    },
    "type": "object",
    "required": ["name", "sensors", "doorSwitch"],
    "properties": {
      "name": {
        "title": "Garage Door Name",
        "description": "Garage door name",
        "type": "string",
        "default": "Garage Door"
      },
      "sensors": {
        "title": "sensors",
        "description": "Number of door actuator sensor(s) installed [Default: 0]",
        "type": "integer",
        "placeholder": 0,
        "default": 0,
        "oneOf": [
          { "title": "No sensor installed", "const": [0] },
          { "title": "(1) sensor installed", "const": [1] },
          { "title": "(2) sensors installed", "const": [2] }
        ]
      },
      "doorSwitch": {
        "type": "object",
        "required": ["GPIO"],
        "properties": {
          "GPIO": {
            "title": "GPIO",
            "description": "Garage door relay switch GPIO",
            "$ref": "#/definitions/ValidPin"
          },
          "pressTimeInMs": {
            "title": "pressTimeInMs",
            "description": "The number of milliseconds to wait before releasing the relay switch. [Default: 1500 milliseconds]",
            "type": "integer",
            "default": 1500,
            "minimum": 1000,
            "maximum": 2000
          },
          "moveTimeInSec": {
            "title": "moveTimeInSec",
            "description": "The number of seconds to wait before garage door to open or close is expected to be completed. [Default: 12 seconds]",
            "type": "integer",
            "default": 12,
            "minimum": 10,
            "maximum": 15
          },
          "relaySwitch": {
            "title": "Relay Switch Connection",
            "description": "Door relay switch connection type. [Default: NO - Normally Open]",
            "$ref": "#/definitions/SensorSignal",
            "placeholder": "NO"
          },
          "interruptDoorRequest": {
            "title": "Interrupt Door Request",
            "description": "Allow current open or close door operation to be stopped, reversed or do nothing when a new request is received. [Default: off]",
            "type": "string",
            "placeholder": "off",
            "oneOf": [
              { "title": "Stop door movement", "const": ["stop"] },
              { "title": "Do NOT stop movement", "const": ["off"] },
              { "title": "Reverse door movement", "const": ["on"] }
            ]
          }
        }
      },
      "doorSensor": {
        "condition": { "functionBody": "return model.sensors !== 0;" },
        "type": "object",
        "required": ["GPIO"],
        "properties": {
          "GPIO": {
            "title": "GPIO",
            "description": "Primary Sensor",
            "$ref": "#/definitions/ValidPin"
          },
          "actuator": {
            "title": "primary sensor connection",
            "description": "Primary actuator sensor connection type. [Default: NO - Normally Open]",
            "$ref": "#/definitions/SensorSignal"
          },
          "position": {
            "condition": { "functionBody": "return model.sensors === 1;" },
            "title": "primary sensor door orientation",
            "description": "Sensor installed to detect when the door is either open or closed. [Default: closed]",
            "type": "string",
            "placeholder": "closed",
            "oneOf": [
              { "title": "fully open", "const": ["open"] },
              { "title": "fully closed", "const": ["closed"] }
            ]
          }
        }
      },
      "doorSensor2": {
        "condition": { "functionBody": "return model.sensors === 2;" },
        "type": "object",
        "required": ["GPIO"],
        "properties": {
          "GPIO": {
            "title": "GPIO",
            "description": "Secondary Sensor",
            "$ref": "#/definitions/ValidPin"
          },
          "actuator": {
            "title": "secondary sensor connection",
            "description": "Secondary actuator sensor connection type. [Default: NO - Normally Open]",
            "$ref": "#/definitions/SensorSignal",
            "placeholder": "NO"
          }
        }
      }
    }
  }
}
